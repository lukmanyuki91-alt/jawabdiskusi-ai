    /* CLEAN & FORMAT ACADEMIC TEXT (REMOVES EXCESSIVE ASTERISKS) */
    function cleanAndFormatAcademicText(rawText) {
      if (!rawText) return '';

      // 1. Convert markdown bold/italic asterisks *** / ** / * to clean HTML elements
      let clean = rawText
        .replace(/\*\*\*(.*?)\*\*\*/g, '<strong><em>$1</em></strong>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>');

      // 2. Convert raw markdown bullet points starting with * or - into clean bullet points
      clean = clean.replace(/^[\t ]*[\*\-][\t ]+/gm, '• ');

      // 3. Remove any orphan/stray asterisks leftover in text
      clean = clean.replace(/\*/g, '');

      // 4. Split text into clean paragraphs and preserve line breaks
      const paragraphs = clean.split(/\n\s*\n/);
      return paragraphs.map(p => {
        const formattedParagraph = p.trim().replace(/\n/g, '<br>');
        return `<p class="mb-3.5 leading-relaxed text-slate-900">${formattedParagraph}</p>`;
      }).join('');
    }

    /* AI DETECTION SCORE ANALYZER FUNCTION */
    function analyzeAiDetection() {
      const text = document.getElementById('outputAnswerArea').innerText;
      if (!text || text.includes('Hasil draf jawaban terstruktur')) {
        showToast('Belum ada teks jawaban untuk dianalisis.', 'warning');
        return;
      }

      // Word & Paragraph metrics
      const words = text.trim().split(/\s+/).filter(w => w.length > 0);
      const wordCount = words.length;
      const paragraphCount = text.split(/\n\s*\n/).length;

      // Detect First-Person POV
      const firstPersonRegex = /\b(saya|pemahaman saya|analisis saya|menurut saya|pengalaman saya)\b/i;
      const hasFirstPerson = firstPersonRegex.test(text);

      // Detect Academic Citation Patterns
      const citationRegex = /\b(BMP|Modul|202\d|201\d|UU No|Tahun|Halaman|hal\.|Daftar Pustaka)\b/i;
      const hasCitation = citationRegex.test(text);

      // Detect Cliche LLM phrases
      const clicheRegex = /\b(era digitalisasi|sebagai kesimpulan|penting untuk dicatat|dalam konteks ini|secara komprehensif|berikut adalah)\b/gi;
      const clicheMatches = text.match(clicheRegex) || [];

      // Calculate estimated AI detection probability score
      let score = 15; // baseline low human score
      if (!hasFirstPerson) score += 20;
      if (!hasCitation) score += 25;
      score += (clicheMatches.length * 10);
      if (wordCount < 100) score += 15;

      score = Math.min(Math.max(score, 6), 88); // bound between 6% and 88%

      // UI Updates
      document.getElementById('aiScoreValue').innerText = `${score}%`;
      document.getElementById('metricWordCount').innerText = `${wordCount} Kata / ${paragraphCount} Paragraf`;
      document.getElementById('metricFirstPerson').innerText = hasFirstPerson ? "Tercakup (Gaya Organik)" : "Tidak Ada (Gaya Pasif/AI)";
      document.getElementById('metricCitation').innerText = hasCitation ? "Terdeteksi (Lengkap)" : "Tidak Ada Citasi";
      document.getElementById('metricCliche').innerText = `${clicheMatches.length} Frasa Terdeteksi`;

      const badge = document.getElementById('aiScoreBadge');
      if (score < 25) {
        badge.className = "inline-block text-xs font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800";
        badge.innerText = "Sangat Aman (Lolos AI Detector)";
      } else if (score < 50) {
        badge.className = "inline-block text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-800";
        badge.innerText = "Sedang (Perlu Sedikit Variasi Kalimat)";
      } else {
        badge.className = "inline-block text-xs font-bold px-3 py-1 rounded-full bg-red-100 text-red-800";
        badge.innerText = "Risiko Tinggi Deteksi AI";
      }

      document.getElementById('aiDetectorModal').classList.remove('hidden');
    }

