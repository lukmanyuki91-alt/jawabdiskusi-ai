      const course = document.getElementById('sharedCourseInput').value;
      if (!text || text.includes('Hasil draf jawaban terstruktur')) {
        showToast('Tidak ada konten untuk disimpan.', 'warning');
        return;
      }
      saveDraftToHistory(course, currentTab, text);
      showToast('Draf disimpan ke Riwayat!');
    }

    function loadHistoryFromStorage() {
      const saved = localStorage.getItem('ut_draft_history');
      if (saved) {
        try { draftHistory = JSON.parse(saved); } catch(e){}
      }
      updateHistoryBadge();
    }

    function updateHistoryBadge() {
      document.getElementById('historyBadge').innerText = draftHistory.length;
    }

    function openHistoryModal() {
      renderHistoryList();
      document.getElementById('historyModal').classList.remove('hidden');
    }

    function closeHistoryModal() {
      document.getElementById('historyModal').classList.add('hidden');
    }

    function renderHistoryList() {
      const container = document.getElementById('historyListContainer');
      if (draftHistory.length === 0) {
        container.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs">Belum ada riwayat draf tersimpan.</div>`;
        return;
      }

      container.innerHTML = draftHistory.map(item => `
        <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg flex justify-between items-start gap-3 hover:border-ut-blue transition">
          <div class="space-y-1 flex-1">
            <div class="flex items-center gap-2">
              <span class="bg-ut-blue text-white text-[10px] font-bold px-2 py-0.5 rounded">${item.type}</span>
              <span class="text-xs font-bold text-slate-800">${item.course}</span>
            </div>
            <p class="text-[11px] text-slate-500"><i class="fa-regular fa-clock mr-1"></i> ${item.date}</p>
            <p class="text-xs text-slate-600 line-clamp-2">${item.content.substring(0, 150)}...</p>
          </div>
          <div class="flex items-center space-x-1">
            <button onclick="loadHistoryItem(${item.id})" class="p-1.5 text-xs bg-ut-blue text-white rounded hover:bg-ut-navy" title="Muat ke Canvas"><i class="fa-solid fa-arrow-right-to-bracket"></i></button>
            <button onclick="deleteHistoryItem(${item.id})" class="p-1.5 text-xs bg-red-100 text-red-600 rounded hover:bg-red-200" title="Hapus"><i class="fa-solid fa-trash"></i></button>
          </div>
        </div>
      `).join('');
    }

    function loadHistoryItem(id) {
      const item = draftHistory.find(d => d.id === id);
      if (item) {
        document.getElementById('outputAnswerArea').innerHTML = item.content.replace(/\n/g, '<br>');
        document.getElementById('sharedCourseInput').value = item.course;
        updateBjuHeader();
        closeHistoryModal();
        showToast('Draf dimuat ke lembar jawaban!');
      }
    }

    function deleteHistoryItem(id) {
      draftHistory = draftHistory.filter(d => d.id !== id);
      localStorage.setItem('ut_draft_history', JSON.stringify(draftHistory));
      updateHistoryBadge();
      renderHistoryList();
      showToast('Draf dihapus.');
    }

    function clearAllHistory() {
      draftHistory = [];
      localStorage.removeItem('ut_draft_history');
      updateHistoryBadge();
      renderHistoryList();
      showToast('Semua riwayat dihapus.');
    }

    /* CUSTOM TOAST NOTIFICATIONS */
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      
      const bgClass = type === 'warning' ? 'bg-amber-600' : 'bg-slate-900';
      toast.className = `${bgClass} text-white text-xs font-medium px-4 py-2.5 rounded-lg shadow-xl flex items-center gap-2 transition-all transform translate-y-2 opacity-0 pointer-events-auto border border-slate-700`;
      toast.innerHTML = `<i class="fa-solid ${type === 'warning' ? 'fa-triangle-exclamation text-amber-300' : 'fa-circle-check text-emerald-400'}"></i> <span>${message}</span>`;

      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }
  </script>

</body>
</html>
