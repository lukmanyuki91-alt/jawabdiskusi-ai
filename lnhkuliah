  <script>
    /* GLOBAL APPLICATION STATE */
    let currentTab = 'discussion';
    let userProfile = {
      name: 'LUKMAN NURHAKIM',
      nim: '059027883',
      prodi: 'SISTEM INFORMASI',
      fakultas: 'FAKULTAS SAINS DAN TEKNOLOGI (FST)',
      upbjj: 'GARUT'
    };
    let draftHistory = [];
    let attachedModules = []; // Holds list of loaded reference files: { id, name, size, type, text, active: true, pages }

    /* INITIALIZATION ON WINDOW LOAD */
    window.onload = function() {
      loadProfileFromStorage();
      loadApiKeyFromStorage();
      loadHistoryFromStorage();
      setupDragAndDrop();
      updateProfileUI();
      updateBjuHeader();
      setCurrentDate();
      renderAttachedFilesList();
    };

    function setCurrentDate() {
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      document.getElementById('bjuDate').innerText = new Date().toLocaleDateString('id-ID', options);
    }

    /* PROFILE MANAGEMENT */
    function loadProfileFromStorage() {
      const saved = localStorage.getItem('ut_user_profile');
      if (saved) {
        try { userProfile = JSON.parse(saved); } catch(e){}
      }
    }

    function saveProfile() {
      userProfile.name = document.getElementById('editName').value.trim() || 'LUKMAN NURHAKIM';
      userProfile.nim = document.getElementById('editNim').value.trim() || '059027883';
      userProfile.prodi = document.getElementById('editProdi').value.trim() || 'SISTEM INFORMASI';
      userProfile.fakultas = document.getElementById('editFakultas').value.trim() || 'FAKULTAS SAINS DAN TEKNOLOGI (FST)';
      userProfile.upbjj = document.getElementById('editUpbjj').value.trim() || 'GARUT';

      localStorage.setItem('ut_user_profile', JSON.stringify(userProfile));
      updateProfileUI();
      closeProfileModal();
      showToast('Profil mahasiswa berhasil diperbarui!');
    }

    function updateProfileUI() {
      document.getElementById('navStudentName').innerText = userProfile.name;
      document.getElementById('dispName').innerText = userProfile.name;
      document.getElementById('dispNim').innerText = userProfile.nim;
      document.getElementById('dispProdi').innerText = userProfile.prodi + " (FST)";
      document.getElementById('dispUpbjj').innerText = "24 / " + userProfile.upbjj;
    }

    function openProfileModal() {
      document.getElementById('editName').value = userProfile.name;
      document.getElementById('editNim').value = userProfile.nim;
      document.getElementById('editProdi').value = userProfile.prodi;
      document.getElementById('editFakultas').value = userProfile.fakultas;
      document.getElementById('editUpbjj').value = userProfile.upbjj;
      document.getElementById('profileModal').classList.remove('hidden');
    }

    function closeProfileModal() {
      document.getElementById('profileModal').classList.add('hidden');
    }

    /* BJU HEADER SYNC FUNCTION */
    function updateBjuHeader() {
      const course = document.getElementById('sharedCourseInput').value || 'MSIM4301 - Analisis & Perancangan Sistem';
      let sessionText = 'Sesi 1';

      if (currentTab === 'discussion') {
        sessionText = document.getElementById('discSessionSelect').value;
      } else if (currentTab === 'task') {
        sessionText = document.getElementById('taskNumberSelect').value;
      } else if (currentTab === 'metopen') {
        sessionText = 'Metode Penelitian';
      }

      document.getElementById('bjuCourse').innerText = course;
      document.getElementById('bjuSession').innerText = sessionText;
    }

    /* TAB SWITCHING */
    function switchTab(tabName) {
      currentTab = tabName;
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('text-ut-blue', 'border-b-2', 'border-ut-blue', 'bg-white');
        btn.classList.add('text-slate-500');
      });
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
      });

      document.getElementById(`tabBtn-${tabName}`).classList.add('text-ut-blue', 'border-b-2', 'border-ut-blue', 'bg-white');
      document.getElementById(`tabBtn-${tabName}`).classList.remove('text-slate-500');
      document.getElementById(`tabContent-${tabName}`).classList.remove('hidden');

      updateBjuHeader();
    }

    function setCourse(courseName) {
      document.getElementById('sharedCourseInput').value = courseName;
      updateBjuHeader();
      showToast(`Mata Kuliah diset: ${courseName}`);
    }

    function toggleExpandTextarea(id) {
      const el = document.getElementById(id);
      if (el.rows === 5 || el.rows === 6) {
        el.rows = 14;
      } else {
        el.rows = 5;
      }
    }

    /* API KEY MANAGEMENT */
    function loadApiKeyFromStorage() {
      const key = localStorage.getItem('ut_gemini_api_key');
      const dot = document.getElementById('apiKeyDot');
      const statusText = document.getElementById('apiKeyStatusText');

      if (key && key.length > 5) {
        dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400";
        statusText.innerText = "API Key Aktif";
      } else {
        dot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse";
        statusText.innerText = "Set API Key";
      }
    }

    function openApiKeyModal() {
      const key = localStorage.getItem('ut_gemini_api_key') || '';
      document.getElementById('geminiApiKeyInput').value = key;
      document.getElementById('apiKeyModal').classList.remove('hidden');
    }

    function closeApiKeyModal() {
      document.getElementById('apiKeyModal').classList.add('hidden');
    }

    function saveApiKey() {
      const key = document.getElementById('geminiApiKeyInput').value.trim();
      if (key) {
        localStorage.setItem('ut_gemini_api_key', key);
        showToast('API Key Gemini berhasil disimpan!');
      } else {
        localStorage.removeItem('ut_gemini_api_key');
        showToast('API Key dikosongkan. Menggunakan runtime bawaan.', 'warning');
      }
      loadApiKeyFromStorage();
      closeApiKeyModal();
    }

    /* MULTI-FILE MODULE UPLOAD & MANAGEMENT LOGIC */
    function setupDragAndDrop() {
      const dropZone = document.getElementById('dropZone');
      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropZone.classList.add('drop-zone--over');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropZone.classList.remove('drop-zone--over');
        }, false);
      });

      dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
          processMultipleFiles(files);
        }
      });
    }

    async function handleFileUpload(event) {
      const files = event.target.files;
      if (!files || files.length === 0) return;
      await processMultipleFiles(files);
      event.target.value = ''; // Reset input
    }

    async function processMultipleFiles(files) {
      showToast(`Memproses ${files.length} file pembantu...`);

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        let fileText = '';
        let pageCount = 1;

        try {
          if (file.type === "application/pdf" || file.name.endsWith('.pdf')) {
            const pdfData = await readPdfFile(file);
