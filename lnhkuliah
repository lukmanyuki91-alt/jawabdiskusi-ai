<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Asisten Akademik & Tugas UT - JawabDiskusi AI (Dengan Multi-File Modul & Anti-Deteksi AI)</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- PDF.js library for multi-PDF parsing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            ut: {
              blue: '#003366',
              navy: '#002244',
              gold: '#FDB813',
              yellow: '#FFCC00',
              light: '#F4F7FA',
              card: '#FFFFFF'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            academic: ['Times New Roman', 'serif']
          }
        }
      }
    }
  </script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F1F5F9;
    }

    /* Custom BJU Print Styling */
    @media print {
      body * {
        visibility: hidden;
      }
      #bjuContainer, #bjuContainer * {
        visibility: visible;
      }
      #bjuContainer {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 20px;
        box-shadow: none !important;
        border: none !important;
      }
      .no-print {
        display: none !important;
      }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Drag & Drop File Zone Style */
    .drop-zone--over {
      border-color: #003366 !important;
      background-color: #eff6ff !important;
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 flex flex-col">

  <!-- Top Navigation Header -->
  <header class="bg-ut-blue text-white shadow-md sticky top-0 z-40">
    <div class="max-w-[1700px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-4">
      <!-- Logo & Title -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-ut-gold rounded-lg flex items-center justify-center text-ut-navy font-bold text-xl shadow">
          UT
        </div>
        <div>
          <h1 class="text-lg font-bold leading-tight flex items-center gap-2">
            Asisten Akademik & Tugas UT
            <span class="bg-amber-400 text-slate-900 text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider">PRO S1 SI</span>
          </h1>
          <p class="text-xs text-slate-200">Generator Tanggapan Tuton & Metopen Berbasis Multi-Modul BMP & Gemini AI</p>
        </div>
      </div>

      <!-- Quick Actions & Status -->
      <div class="flex items-center space-x-3 text-xs sm:text-sm">
        <!-- API Key Status Indicator -->
        <button onclick="openApiKeyModal()" id="apiKeyStatusBtn" class="flex items-center space-x-2 bg-slate-800/80 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-600 transition">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" id="apiKeyDot"></span>
          <span id="apiKeyStatusText" class="font-medium">Cek API Key</span>
        </button>

        <!-- User Profile Quick View -->
        <button onclick="openProfileModal()" class="flex items-center space-x-2 bg-ut-navy hover:bg-slate-900 px-3 py-1.5 rounded-lg border border-ut-gold/40 text-amber-300 font-medium transition">
          <i class="fa-solid fa-user-graduate"></i>
          <span id="navStudentName">LUKMAN NURHAKIM</span>
        </button>

        <!-- History Button -->
        <button onclick="openHistoryModal()" class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg border border-slate-600 flex items-center gap-1.5 transition" title="Riwayat Draft Jawaban">
          <i class="fa-solid fa-clock-rotate-left text-amber-400"></i>
          <span class="hidden md:inline">Riwayat</span>
          <span id="historyBadge" class="bg-amber-400 text-slate-900 font-bold text-[10px] px-1.5 py-0.2 rounded-full">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="max-w-[1700px] mx-auto px-4 sm:px-6 py-6 flex-1 w-full grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- LEFT PANEL: Input & Form Configuration (5 Cols) -->
    <section class="lg:col-span-5 flex flex-col gap-5">
      
      <!-- Quick Course Selector Chips -->
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
          <i class="fa-solid fa-bolt text-amber-500 mr-1"></i> Pilih Cepat Mata Kuliah Sistem Informasi (UT)
        </label>
        <div class="flex flex-wrap gap-1.5 text-xs">
          <button onclick="setCourse('MSIM4301 - Analisis & Perancangan Sistem')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">MSIM4301 (APS)</button>
          <button onclick="setCourse('MSIM4303 - Rekayasa Perangkat Lunak')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">MSIM4303 (RPL)</button>
          <button onclick="setCourse('MSIM4304 - Basis Data')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">MSIM4304 (Basis Data)</button>
          <button onclick="setCourse('MSIM4201 - Pemrograman Berbasis Desktop')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">MSIM4201 (Desktop)</button>
          <button onclick="setCourse('MSIM4401 - Keamanan Sistem Informasi')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">MSIM4401 (Keamanan SI)</button>
          <button onclick="setCourse('ISIP4211 - Logika')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">ISIP4211 (Logika)</button>
          <button onclick="setCourse('MKWU4108 - Bahasa Indonesia')" class="px-2.5 py-1 bg-slate-100 hover:bg-ut-blue hover:text-white rounded-md text-slate-700 font-medium transition border border-slate-200">MKWU4108 (B. Indo)</button>
        </div>
      </div>

      <!-- Tabbed Mode Input Container -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden">
        
        <!-- Navigation Tabs -->
        <div class="flex border-b border-slate-200 bg-slate-50 overflow-x-auto text-xs sm:text-sm font-semibold">
          <button id="tabBtn-discussion" onclick="switchTab('discussion')" class="tab-btn px-4 py-3 text-ut-blue border-b-2 border-ut-blue bg-white flex items-center gap-2 whitespace-nowrap transition">
            <i class="fa-solid fa-comments"></i> Diskusi Tuton
          </button>
          <button id="tabBtn-task" onclick="switchTab('task')" class="tab-btn px-4 py-3 text-slate-500 hover:text-ut-blue flex items-center gap-2 whitespace-nowrap transition">
            <i class="fa-solid fa-file-pen"></i> Tugas Tuton
          </button>
          <button id="tabBtn-metopen" onclick="switchTab('metopen')" class="tab-btn px-4 py-3 text-slate-500 hover:text-ut-blue flex items-center gap-2 whitespace-nowrap transition">
            <i class="fa-solid fa-graduation-cap"></i> Metopen / Proposal
          </button>
          <button id="tabBtn-modules" onclick="switchTab('modules')" class="tab-btn px-4 py-3 text-slate-500 hover:text-ut-blue flex items-center gap-2 whitespace-nowrap transition">
            <i class="fa-solid fa-folder-open"></i> File Modul Pembantu
            <span id="moduleCountBadge" class="bg-amber-400 text-slate-900 font-extrabold text-[10px] px-2 py-0.5 rounded-full">0 File</span>
          </button>
        </div>

        <!-- TAB CONTENT AREA -->
        <div class="p-5 space-y-4">

          <!-- Shared Course Input -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Mata Kuliah UT</label>
            <input type="text" id="sharedCourseInput" oninput="updateBjuHeader()" value="MSIM4301 - Analisis & Perancangan Sistem" placeholder="Contoh: MSIM4301 - Analisis & Perancangan Sistem" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
          </div>

          <!-- Active Attached Files Quick Indicator Banner -->
          <div id="activeFilesBanner" onclick="switchTab('modules')" class="bg-amber-50 hover:bg-amber-100 border border-amber-300 rounded-lg p-2.5 text-xs text-amber-900 flex items-center justify-between cursor-pointer transition">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-file-pdf text-amber-600 text-base"></i>
              <div>
                <strong id="activeFilesBannerText">0 File Modul Pembantu Terpasang</strong>
                <p class="text-[10px] text-amber-700">Setiap file pembantu yang diunggah akan dijadikan rujukan utama AI.</p>
              </div>
            </div>
            <span class="text-[11px] font-bold text-ut-blue hover:underline whitespace-nowrap"><i class="fa-solid fa-plus mr-1"></i>Kelola File</span>
          </div>

          <!-- TAB 1: DISKUSI TUTON -->
          <div id="tabContent-discussion" class="tab-content space-y-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Sesi Tuton</label>
                <select id="discSessionSelect" onchange="updateBjuHeader()" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
                  <option value="Sesi 1">Sesi 1</option>
                  <option value="Sesi 2">Sesi 2</option>
                  <option value="Sesi 3">Sesi 3</option>
                  <option value="Sesi 4">Sesi 4</option>
                  <option value="Sesi 5">Sesi 5</option>
                  <option value="Sesi 6">Sesi 6</option>
                  <option value="Sesi 7">Sesi 7</option>
                  <option value="Sesi 8">Sesi 8</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Gaya Sapaan Resmi</label>
                <select id="discGreetingSelect" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
                  <option value="default">Sapaan Tuton Standar UT (Lukman Nurhakim)</option>
                  <option value="formal">Sapaan Formal Akademis</option>
                  <option value="friendly">Sapaan Diskusi Interaktif</option>
                </select>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="block text-xs font-bold text-slate-700 uppercase">Pertanyaan / Soal Diskusi LMS</label>
                <button onclick="toggleExpandTextarea('discTaskInput')" class="text-xs text-ut-blue hover:underline"><i class="fa-solid fa-expand mr-1"></i> Perbesar</button>
              </div>
              <textarea id="discTaskInput" rows="5" placeholder="Tempelkan (paste) soal diskusi dari LMS UT di sini..." class="w-full p-3 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none font-sans leading-relaxed"></textarea>
            </div>
          </div>

          <!-- TAB 2: TUGAS TUTON -->
          <div id="tabContent-task" class="tab-content hidden space-y-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Nomor Tugas</label>
                <select id="taskNumberSelect" onchange="updateBjuHeader()" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
                  <option value="Tugas 1">Tugas 1 (Sesi 3)</option>
                  <option value="Tugas 2">Tugas 2 (Sesi 5)</option>
                  <option value="Tugas 3">Tugas 3 (Sesi 7)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Format Pembahasan</label>
                <select id="taskFormatSelect" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
                  <option value="pembahasan_poin">Poin demi Poin Terstruktur + Studi Kasus</option>
                  <option value="makalah">Format Makalah Singkat (Pendahuluan-Isi-Penutup)</option>
                  <option value="analisis_sistem">Analisis Diagram / DFD / Use Case / ERD Naratif</option>
                </select>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="block text-xs font-bold text-slate-700 uppercase">Instruksi & Soal Tugas Utama</label>
                <button onclick="toggleExpandTextarea('taskInstructionsInput')" class="text-xs text-ut-blue hover:underline"><i class="fa-solid fa-expand mr-1"></i> Perbesar</button>
              </div>
              <textarea id="taskInstructionsInput" rows="6" placeholder="Salin lengkap instruksi soal Tugas 1/2/3 beserta petunjuk pengerjaannya..." class="w-full p-3 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none font-sans leading-relaxed"></textarea>
            </div>
          </div>

          <!-- TAB 3: METOPEN & PROPOSAL -->
          <div id="tabContent-metopen" class="tab-content hidden space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Topik / Judul Proposal Penelitian SI</label>
              <input type="text" id="metopenTopicInput" placeholder="Contoh: Evaluasi Penerimaan SIMRS Menggunakan Metode UTAUT 2 di RSUD Garut" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Fokus Bagian</label>
                <select id="metopenSectionSelect" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
                  <option value="lengkap">Draf Proposal Ringkas (Bab 1, 2, 3)</option>
                  <option value="bab1">Bab 1: Latar Belakang & Rumusan Masalah</option>
                  <option value="bab2">Bab 2: Tinjauan Pustaka & Hipotesis</option>
                  <option value="bab3">Bab 3: Metodologi Penelitian & Teknik Sampling</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Pendekatan</label>
                <select id="metopenTypeSelect" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none">
                  <option value="kuantitatif">Kuantitatif (Survei / TAM / UTAUT)</option>
                  <option value="kualitatif">Kualitatif (Studi Kasus / Analisis Kebutuhan)</option>
                  <option value="pengembangan">R&D / Waterfall / Agile Software Dev</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Catatan Tambahan / Objek Penelitian</label>
              <textarea id="metopenNotesInput" rows="3" placeholder="Masukkan detail lokasi penelitian, jumlah sampel target, atau variabel utama..." class="w-full p-3 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-ut-blue focus:outline-none"></textarea>
            </div>
          </div>

          <!-- TAB 4: MODUL BMP & FILE PEMBANTU (Multi-File Extraction & Management) -->
          <div id="tabContent-modules" class="tab-content hidden space-y-4">
            
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs text-slate-700 space-y-1">
              <div class="flex items-center gap-1.5 font-bold text-ut-blue">
                <i class="fa-solid fa-layer-group text-amber-500"></i> Multi-File Reader Modul BMP & Dokumen Pembantu
              </div>
              <p>Unggah atau pilih beberapa file PDF modul UT, catatan ringkasan, atau referensi jurnal sekaligus. Teks dari file aktif akan digabungkan secara otomatis sebagai rujukan presisi saat men-generate jawaban.</p>
            </div>

            <!-- Drag & Drop Upload Container -->
            <div id="dropZone" class="border-2 border-dashed border-slate-300 rounded-xl p-5 text-center bg-slate-50 hover:bg-slate-100/80 transition cursor-pointer relative">
              <input type="file" id="pdfFileInput" accept=".pdf,.txt,.md,.docx" multiple onchange="handleFileUpload(event)" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
              <div class="space-y-2 pointer-events-none">
                <div class="w-12 h-12 bg-ut-blue/10 text-ut-blue rounded-full flex items-center justify-center mx-auto">
                  <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-800">Klik atau Tarik File ke Sini (Bisa Banyak File)</p>
                  <p class="text-[11px] text-slate-500">Mendukung format PDF, TXT, MD. (Maksimal 10 MB per file)</p>
                </div>
              </div>
            </div>

            <!-- Quick Add Preset Samples Button Row -->
            <div class="flex items-center justify-between pt-1">
              <span class="text-xs font-bold text-slate-600">Tambah Preset Modul Contoh:</span>
              <div class="flex gap-1.5 text-xs">
                <button onclick="addPresetModule('MSIM4301')" class="px-2 py-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded text-[11px] transition">+ BMP MSIM4301</button>
                <button onclick="addPresetModule('MSIM4303')" class="px-2 py-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded text-[11px] transition">+ BMP MSIM4303</button>
                <button onclick="addPresetModule('UU_PDP')" class="px-2 py-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded text-[11px] transition">+ UU PDP No 27/2022</button>
              </div>
            </div>

            <!-- List of Attached Files -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-bold text-slate-700 uppercase flex items-center gap-1.5">
                  <i class="fa-solid fa-list-check text-emerald-600"></i> Daftar File Pembantu Terpasang
                  <span id="fileCountBadge" class="bg-ut-blue text-white text-[10px] px-2 py-0.2 rounded-full font-bold">0 File</span>
                </span>
                <button onclick="clearAllModuleFiles()" class="text-xs text-red-600 hover:underline"><i class="fa-solid fa-trash-can mr-1"></i> Hapus Semua File</button>
              </div>

              <!-- File Items Wrapper -->
              <div id="attachedFilesList" class="space-y-2 max-h-[300px] overflow-y-auto pr-1">
                <!-- Empty State Message -->
                <div id="emptyFilesNotice" class="text-center py-8 bg-slate-50 border border-dashed border-slate-200 rounded-lg text-xs text-slate-400">
                  <i class="fa-solid fa-folder-open text-3xl mb-2 text-slate-300"></i>
                  <p>Belum ada file modul/pembantu yang diunggah.</p>
                  <p class="text-[11px] text-slate-400">Gunakan tombol unggah di atas atau pilih preset modul contoh.</p>
                </div>
              </div>
            </div>

          </div>

          <!-- Humanizer, Anti-AI Detection & Reference Settings -->
          <div class="pt-3 border-t border-slate-200 bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i class="fa-solid fa-shield-cat text-emerald-600 text-sm"></i> Engine Anti-Deteksi AI & Persona Mahasiswa
              </span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="humanizerToggle" checked class="sr-only peer">
                <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
              </label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div>
                <label class="block text-slate-700 mb-1 font-semibold">Tingkat Penjelas & Perplexity AI</label>
                <select id="aiIntensitySelect" class="w-full p-2 border border-slate-300 rounded bg-white focus:outline-none font-medium">
                  <option value="ultra_human">Ultra-Human (< 15% Deteksi AI / Burstiness Tinggi)</option>
                  <option value="balanced" selected>Seimbang (Natural Akademis ~ 25% Deteksi)</option>
                  <option value="academic_strict">Formal Akademis Murni (Baku BMP UT)</option>
                </select>
              </div>

              <div>
                <label class="block text-slate-700 mb-1 font-semibold">Pengayaan Sitasi & Referensi</label>
                <select id="enrichmentSelect" class="w-full p-2 border border-slate-300 rounded bg-white focus:outline-none font-medium">
                  <option value="bmp_uu">BMP UT + Citasi UU ITE (2024) / UU PDP</option>
                  <option value="bmp_studi_kasus">BMP UT + Kasus Industri SI / IT Indonesia</option>
                  <option value="bmp_iso">BMP UT + Standar ISO 27001 / COBIT / IEEE</option>
                  <option value="murni_bmp">Fokus Utama Doktrin Teori BMP UT</option>
                </select>
              </div>
            </div>

            <div class="flex items-center justify-between pt-1">
              <label class="inline-flex items-center cursor-pointer text-xs font-medium text-slate-700">
                <input type="checkbox" id="includeBibliographyToggle" checked class="rounded border-slate-300 text-ut-blue focus:ring-ut-blue h-4 w-4 mr-2">
                Sertakan Daftar Pustaka (APA 7th Edition) Otomatis
              </label>
            </div>
          </div>

          <!-- GENERATE BUTTON -->
          <button id="generateBtn" onclick="generateAIResponse()" class="w-full py-3 px-4 bg-gradient-to-r from-ut-blue to-ut-navy hover:from-slate-900 hover:to-ut-blue text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 group">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-400 group-hover:rotate-12 transition-transform"></i>
            <span>GENERATE DRAF JAWABAN (FORMAT UT)</span>
          </button>

        </div>
      </div>
    </section>

    <!-- RIGHT PANEL: KOP BJU UT Sheet & Output Preview (7 Cols) -->
    <section class="lg:col-span-7 flex flex-col gap-4">
      
      <!-- Preview Header Toolbar -->
      <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center space-x-2">
          <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
